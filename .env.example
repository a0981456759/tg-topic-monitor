# Create these at https://my.telegram.org/apps. Keep this file free of real values.
TG_API_ID=
TG_API_HASH=
TG_PHONE=+8613800000000

# Comma-separated words or phrases. Matching is case-insensitive.
TG_KEYWORDS=AI Agent,投資

# Optional, but strongly recommended: @group_username or a Telegram peer ID.
# Empty means every group/channel that this account can read.
TG_CHATS=@your_group

# The digest is sent by the long-running monitor at this local time and covers the previous calendar day.
TG_TIMEZONE=Asia/Shanghai
TG_DIGEST_TIME=00:05

# Telegram notification target: me (Saved Messages), @group_username, or a peer ID such as -100...
TG_NOTIFY_CHAT=me

# Optional: send the same notifications to one Slack channel via an Incoming Webhook.
# Keep this URL private, exactly like a password.
SLACK_WEBHOOK_URL=
